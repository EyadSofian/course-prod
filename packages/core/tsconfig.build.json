{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext, not Bundler: this package emits real ESM that Node loads
    // directly in the worker, so the .js extensions on relative imports are
    // required rather than decorative.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
