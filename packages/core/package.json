{
  "name": "@course-prod/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./stages": {
      "types": "./dist/stages.d.ts",
      "default": "./dist/stages.js"
    },
    "./costs": {
      "types": "./dist/costs.d.ts",
      "default": "./dist/costs.js"
    },
    "./pronunciation": {
      "types": "./dist/pronunciation.d.ts",
      "default": "./dist/pronunciation.js"
    },
    "./providers/llm": {
      "types": "./dist/providers/llm.d.ts",
      "default": "./dist/providers/llm.js"
    },
    "./providers/tts": {
      "types": "./dist/providers/tts.d.ts",
      "default": "./dist/providers/tts.js"
    },
    "./providers/dokie": {
      "types": "./dist/providers/dokie.d.ts",
      "default": "./dist/providers/dokie.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./settings-store": {
      "types": "./dist/settings-store.d.ts",
      "default": "./dist/settings-store.js"
    },
    "./providers/voices": {
      "types": "./dist/providers/voices.d.ts",
      "default": "./dist/providers/voices.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "pnpm build && node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "drizzle-orm": "^0.36.4",
    "hash-wasm": "^4.11.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
