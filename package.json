{
  "name": "course-prod",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @course-prod/core db:generate",
    "db:migrate": "pnpm --filter @course-prod/core db:migrate",
    "db:studio": "pnpm --filter @course-prod/core db:studio",
    "bootstrap:admin": "pnpm --filter @course-prod/core bootstrap:admin"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
