{
  "name": "@course-prod/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @course-prod/core build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test \"test/**/*.test.js\"",
    "pretypecheck": "pnpm --filter @course-prod/core build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@course-prod/core": "workspace:*",
    "archiver": "^7.0.1",
    "drizzle-orm": "^0.36.4",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "mammoth": "^1.8.0",
    "pg-boss": "^10.1.5",
    "playwright-core": "1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
