# Copy to .env for local development. Never commit .env (see .gitignore).
# On Railway these are set per-service in the dashboard, not from a file.

# ── shared ────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/course_prod

# openssl rand -base64 32
SESSION_SECRET=
SERVICE_KEY=

PUBLIC_URL=http://localhost:3000
STATE_DIR=./data
MONTHLY_BUDGET_USD=300

# ── web ───────────────────────────────────────────────────────────────────
PORT=3000

# ── worker: AI providers ──────────────────────────────────────────────────
# M2+
ANTHROPIC_API_KEY=

# M5+
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# M3+ — MCP personal access token (Bearer for https://mcp.dokie.ai/mcp)
DOKIE_API_KEY=
# M4+ — browser-export fallback only (§6.5)
DOKIE_EMAIL=
DOKIE_PASSWORD=

# ── alerts (§9) ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── one-time bootstrap (§11) ──────────────────────────────────────────────
# ADMIN_EMAIL=you@engosoft.com
# ADMIN_PASSWORD=
# ADMIN_NAME=
