# Copy to .env for local development. Never commit .env (see .gitignore).
# On Railway these are set per-service in the dashboard, not from a file.

# ── shared ────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/course_prod

# openssl rand -base64 32
SESSION_SECRET=
SERVICE_KEY=

PUBLIC_URL=http://localhost:3000
STATE_DIR=./data
MONTHLY_BUDGET_USD=300

# ── web ───────────────────────────────────────────────────────────────────
PORT=3000
# The Railway volume mounts to the worker only, so web proxies file reads and
# writes through the worker's private HTTP surface.
WORKER_URL=http://localhost:3001

# ── worker: AI providers ──────────────────────────────────────────────────
# M2+ — summarization. OPENAI_API_KEY is the configured provider; the
# Anthropic path stays wired so switching back is a settings change.
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # only for a proxy or Azure-style endpoint
ANTHROPIC_API_KEY=

# M5+
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# M3+ — MCP personal access token (Bearer for https://mcp.dokie.ai/mcp)
DOKIE_API_KEY=
# M4+ — browser-export fallback only (§6.5)
DOKIE_EMAIL=
DOKIE_PASSWORD=
# A finished Dokie project the daily /self-test exports to detect a redesign
# before a producer does (§6.5).
DOKIE_SELFTEST_PROJECT_URL=

# ── alerts (§9) ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── one-time bootstrap (§11) ──────────────────────────────────────────────
# ADMIN_EMAIL=you@engosoft.com
# ADMIN_PASSWORD=
# ADMIN_NAME=
